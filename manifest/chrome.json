{
  "minimum_chrome_version": "120",
  "permissions": ["storage", "unlimitedStorage"],
  "content_scripts": [
    {
      "matches": ["https://open.spotify.com/*"],
      "js": ["bootstrap.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://open.spotify.com/*"],
      "js": ["page.js"],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    }
  ]
}

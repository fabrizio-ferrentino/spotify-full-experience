{
  "manifest_version": 3,
  "name": "Full Experience for Spotify",
  "description": "Desktop app features in the Spotify web player: play counts, liked songs by artist, playlist search and sort. Unofficial.",
  "default_locale": "en",
  "homepage_url": "https://github.com/fabrizio-ferrentino/spotify-full-experience",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://open.spotify.com/*"],
      "js": ["bootstrap.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Full Experience for Spotify",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": false
  }
}

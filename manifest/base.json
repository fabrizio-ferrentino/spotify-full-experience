{
  "manifest_version": 3,
  "name": "Spotify Full Experience",
  "description": "Adds desktop-only information to the web player. Unofficial, not affiliated with Spotify.",
  "default_locale": "en",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://open.spotify.com/*"],
      "js": ["bootstrap.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Spotify Full Experience",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": false
  }
}

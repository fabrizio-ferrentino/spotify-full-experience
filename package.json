{
  "name": "spotify-full-experience",
  "version": "0.0.1",
  "private": true,
  "description": "Browser extension that adds desktop-only information to the Spotify web player.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixture:sanitize": "node scripts/sanitize-fixture.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/node": "^20.19.43",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}

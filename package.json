{
  "name": "spotify-full-experience",
  "version": "2026.10.10",
  "private": true,
  "description": "Browser extension that adds desktop-only information to the Spotify web player.",
  "license": "MIT",
  "homepage": "https://github.com/fabrizio-ferrentino/spotify-full-experience",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabrizio-ferrentino/spotify-full-experience.git"
  },
  "bugs": "https://github.com/fabrizio-ferrentino/spotify-full-experience/issues",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "watch": "node scripts/build.mjs --watch",
    "package": "node scripts/build.mjs && node scripts/package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixture:sanitize": "node scripts/sanitize-fixture.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/node": "^20.19.43",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
